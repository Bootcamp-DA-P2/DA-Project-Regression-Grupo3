    "plt.axvline(x=0, color=\"black\", linewidth=0.8)\n",
    "plt.xlabel(\"Coeficiente (impacto en Acceptance Index)\")\n",
    "plt.title(\"Importancia de las Variables — Ridge Regression\")\n",
