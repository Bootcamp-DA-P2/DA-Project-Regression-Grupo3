   "source": [
    "# cross_val_predict nos da una predicción para CADA fila\n",
    "# (cada fila fue predicha cuando estaba en el fold de \"test\")\n",
    "y_pred = cross_val_predict(pipeline, X, y, cv=kf)\n",
    "\n",
    "# Lo guardamos junto a los valores reales para comparar\n",
    "resultados = pd.DataFrame({\n",
    "    \"real\": y,\n",
    "    \"prediccion\": y_pred\n",
    "})\n",
    "\n",
    "print(resultados.head(10))\n",
    "print(f\"\\nR² global: {r2_score(y, y_pred):.3f}\")"
   ]
  },
